{
  "name": "@karibsen/eponyme-captcha",
  "version": "0.1.0",
  "description": "Captcha verification for Eponyme public forms, backed by Cloudflare Turnstile.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "eponyme",
    "captcha",
    "turnstile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karibsen-studio/eponyme.git",
    "directory": "packages/captcha"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "@nuxtjs/turnstile": "^1.0.1"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "nuxt": "^4.4.8"
  }
}
