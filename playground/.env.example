DATABASE_URL=postgresql://user:password@localhost:5432/test

# File storage. `eponyme.storage.ts` reads the bucket and the endpoint; Eponyme reads the
# credentials. Leave them empty to fall back to the local filesystem driver.
EPONYME_STORAGE_ACCESS_KEY_ID=
EPONYME_STORAGE_SECRET_ACCESS_KEY=
EPONYME_STORAGE_BUCKET=
EPONYME_STORAGE_ENDPOINT=
