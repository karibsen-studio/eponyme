{
  "name": "@karibsen/eponyme",
  "version": "0.8.13",
  "description": "A lightweight, type-safe content manager for Nuxt.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "cms",
    "content",
    "prisma",
    "postgresql",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karibsen-studio/eponyme.git"
  },
  "homepage": "https://github.com/karibsen-studio/eponyme#readme",
  "bugs": {
    "url": "https://github.com/karibsen-studio/eponyme/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./config": {
      "types": "./dist/eponyme.d.mts",
      "import": "./dist/eponyme.mjs"
    },
    "./storage": {
      "types": "./dist/storage.d.mts",
      "import": "./dist/storage.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev --cwd playground",
    "dev:build": "nuxt build --cwd playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare --cwd playground && nuxt prepare --cwd test/fixtures/basic && pnpm --filter ./playground exec prisma generate",
    "release": "npm run lint && npm run test && npm run test:types && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && vue-tsc --noEmit -p test/types/tsconfig.nitro-plugin.json && cd playground && vue-tsc --noEmit && vue-tsc --noEmit -p .nuxt/tsconfig.server.json"
  },
  "dependencies": {
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.3.0",
    "@iconify-json/mingcute": "^1.2.7",
    "@karibsen/ui": "^1.0.1",
    "@nuxt/icon": "^2.3.1",
    "@nuxt/kit": "^4.4.8",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.36",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/vue-3": "^3.28.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "fuse.js": "^7.5.0",
    "h3": "^1.15.11",
    "libphonenumber-js": "^1.13.9",
    "maska": "^3.2.0",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "reka-ui": "^2.10.1",
    "sanitize-html": "2.17.5",
    "slugify": "^1.6.9",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.1.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "latest",
    "@types/sanitize-html": "^2.16.1",
    "@types/sortablejs": "^1.15.9",
    "changelogen": "^0.6.2",
    "eslint": "^10.4.1",
    "ioredis": "^5.4.2",
    "nuxt": "^4.4.8",
    "typescript": "~6.0.3",
    "unbuild": "^3.6.1",
    "unstorage": "^1.17.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
